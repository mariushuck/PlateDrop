# Reverse Proxy für das Compose-Profil `proxy`.
# Bei einer echten Domain besorgt Caddy das TLS-Zertifikat automatisch;
# bei `localhost` wird ein lokal signiertes Zertifikat verwendet.
{$DOMAIN:localhost} {
	encode zstd gzip

	header {
		# Caddy terminiert TLS – HSTS gehört an den Rand. Ersetzt einen evtl.
		# vom Upstream gesetzten Wert, damit der Client nur einen bekommt.
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		# Server-Version nicht preisgeben.
		-Server
	}

	# Beweisfotos sind auf 5 MB begrenzt – etwas Luft für den Multipart-Overhead.
	request_body {
		max_size 8MB
	}

	reverse_proxy web:3000 {
		# Next.js streamt Responses; Puffern würde das zunichtemachen.
		flush_interval -1
	}
}
