# Reverse Proxy für das Compose-Profil `proxy`.
# Bei einer echten Domain besorgt Caddy das TLS-Zertifikat automatisch;
# bei `localhost` wird ein lokal signiertes Zertifikat verwendet.
{$DOMAIN:localhost} {
	encode zstd gzip

	# Beweisfotos sind auf 5 MB begrenzt – etwas Luft für den Multipart-Overhead.
	request_body {
		max_size 8MB
	}

	reverse_proxy web:3000 {
		# Next.js streamt Responses; Puffern würde das zunichtemachen.
		flush_interval -1
	}
}
