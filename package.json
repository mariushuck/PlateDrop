{
  "name": "platedrop",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yml down -v",
    "test:integration": "jest --config jest.integration.config.ts --runInBand",
    "db:migrate": "node scripts/migrate.mjs",
    "db:set-admin": "node scripts/set-admin.mjs",
    "db:prune": "node scripts/maintenance.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "better-auth": "^1.7.10",
    "lucide-react": "^1.57.0",
    "next": "16.4.1",
    "nodemailer": "^10.1.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@swc/jest": "^0.2.39",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "license": "UNLICENSED"
}
