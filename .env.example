# ---------------------------------------------------------------------------
# PlateDrop – Beispielkonfiguration. Kopieren nach `.env` und Werte anpassen.
# Für lokale Entwicklung ohne Docker: `.env.local` mit denselben Schlüsseln,
# aber `localhost` statt der Container-Hostnamen `db` / `mailpit`.
# ---------------------------------------------------------------------------

# --- Postgres (Container `db`) ---------------------------------------------
POSTGRES_DB=platedrop
POSTGRES_USER=platedrop_owner
POSTGRES_PASSWORD=change-me-owner

# Verbindung der App: Rolle `platedrop_app`, ohne BYPASSRLS und ohne Ownership.
# Nur über diese Rolle greifen die RLS-Policies.
APP_DB_PASSWORD=change-me-app
DATABASE_URL=postgres://platedrop_app:change-me-app@db:5432/platedrop

# Verbindung des Migrations-Runners: Owner-Rolle, legt Tabellen und Policies an.
DATABASE_ADMIN_URL=postgres://platedrop_owner:change-me-owner@db:5432/platedrop

# --- Auth (better-auth) -----------------------------------------------------
# Mindestens 32 zufällige Zeichen, z. B. `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me-generate-a-long-random-secret
# Öffentliche Basis-URL. Grundlage der Links in den E-Mails und der
# Origin-Prüfung von better-auth. In Produktion die echte Domain eintragen.
BETTER_AUTH_URL=http://localhost:3000

# --- E-Mail -----------------------------------------------------------------
# In der Entwicklung fängt Mailpit alles ab (UI: http://localhost:8025).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=PlateDrop <noreply@platedrop.local>

# --- Storage ----------------------------------------------------------------
# Verzeichnis für Beweisfotos. Im Container ein Volume, lokal ein Ordner.
PROOFS_DIR=/data/proofs

# --- Wartung / Aufbewahrung ----------------------------------------------------
# Optionale Speicherfrist für Nachrichten in Tagen. Leer = keine automatische
# Löschung (scripts/prune-messages.mjs bzw. `pnpm db:prune`).
MESSAGE_RETENTION_DAYS=
# Aufbewahrung der Rate-Limit-Zeilen in Tagen (scripts/prune-throttle.mjs).
# Leer = Standard 2.
THROTTLE_RETAIN_DAYS=
# Aufbewahrung der Sicherungen in Tagen (scripts/backup.sh, Profil `backup`).
BACKUP_RETENTION_DAYS=14

# --- Rate Limiting ----------------------------------------------------------
# Geheimes Salt zum Hashen der Client-IPs im Nachrichten-Rate-Limiter.
RATE_LIMIT_SALT=change-me-rate-limit-salt
# Vertrauenswürdige Proxy-Hops vor der App. Standard 1 = der Caddy-Proxy aus
# docker-compose. Die echte Client-IP wird als (länge - hops)-ter Eintrag von
# X-Forwarded-For gelesen; 0 schaltet das Vertrauen in den Header ab.
TRUSTED_PROXY_HOPS=1

# --- Reverse Proxy (nur für das Compose-Profil `proxy`) ---------------------
# Domain für automatisches TLS. `localhost` erzeugt ein lokales Caddy-Zertifikat.
DOMAIN=localhost
